# Copia este archivo como .env.local para desarrollo. Nunca subas .env.local a git.

# Plataforma FIF Learning (portal, login, paneles). Mantener en false en producción
# hasta completar la migración a Supabase. En local, true para trabajar en ella.
VITE_ENABLE_PLATFORM=false

# Supabase (fase 2). La anon key es pública por diseño; la seguridad la dan las políticas RLS.
# La service_role key NUNCA va aquí ni en ningún VITE_*: solo en Edge Functions.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
